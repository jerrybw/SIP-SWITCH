# 复制为 .env 后按需修改（.env 已被 .gitignore 忽略，禁止入仓）
#   cp .env.example .env

# ---------- MySQL ----------
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=sip_switch
MYSQL_USER=sip_switch
MYSQL_PASSWORD=change-me

# ---------- FreeSWITCH ----------
# Docker Hub 上不存在 signalwire/freeswitch 运行时镜像（拉取返回 denied），
# 官方 signalwire/freeswitch-public-base 只是编译基座（不含 freeswitch 本体），
# SignalWire 官方 apt 源返回 401 需账号 PAT。故默认使用自建镜像，见 deploy/fs-image/Dockerfile。
FS_IMAGE=sip-switch-fs:1.11.2
# 自建镜像的编译参数（仅 docker compose build freeswitch 时生效）
FS_BASE=signalwire/freeswitch-public-base:latest
FS_REF=v1.11.2
FS_JOBS=8
# ESL 密码：必须与 config/docker/config_settings.yaml 的 esl.password 一致
ESL_PASSWORD=change-me-esl
# xml_curl 回调凭据：FS 请求网关 /fs/*（dialplan/directory/config）的 HTTP Basic 认证。
# 必须与 config/docker/config_settings.yaml 的 xml_curl.user / xml_curl.password 一致
# （deploy.sh 自动生成并两侧同源注入）；不一致时 FS 拉不到任何配置，通话全断。
XMLCURL_USER=xmlcurl
XMLCURL_PASSWORD=change-me-xmlcurl
# 镜像内 FS 配置目录（signalwire 官方镜像通常为 /etc/freeswitch，源码安装为 /usr/local/freeswitch/etc/freeswitch）
# 源码安装（prefix=/usr/local/freeswitch）的布局是 /usr/local/freeswitch/etc/freeswitch
FS_CONF_DIR=/usr/local/freeswitch/etc/freeswitch
# 容器内启动 FS 的命令（不同镜像入口不同，按需调整）
FS_COMMAND=freeswitch -c -nonat
# RTP 端口范围：必须与下面 RTP_RANGE 一致
RTP_START=20000
RTP_END=20100

# ---------- 端口映射（宿主:容器）----------
# internal profile：话机注册 / 入局来话
SIP_PORT=5060
# external profile：落地网关出局 / 运营商来话（bridge 经 sofia/gateway/<name>）
SIP_PORT_EXT=5080
API_PORT=8000
RTP_RANGE=20000-20100
